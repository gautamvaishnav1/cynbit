# Copy this file to .env and fill in real values. Never commit the .env file.

# Include credentials when your MongoDB requires authentication, e.g.:
# mongodb://USERNAME:PASSWORD@127.0.0.1:27017/cynbit?authSource=admin
MONGODB_URI=mongodb://127.0.0.1:27017/cynbit
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=admin@cynbit.in
ADMIN_PASSWORD=replace-with-a-strong-password
PORT=4000
FRONTEND_URL=http://localhost:5173
