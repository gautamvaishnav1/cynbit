# Copy this file to .env and fill in real values. Never commit the .env file.

# MongoDB connection string — get this from your MongoDB provider (e.g. MongoDB Atlas).
# Include credentials when required, e.g.:
#   mongodb://USERNAME:PASSWORD@host:27017/cynbit?authSource=admin
MONGODB_URI=

# Long, random secret used to sign admin JWTs (min 16 characters).
# Generate one: openssl rand -hex 32
JWT_SECRET=

# How long the admin login token lives (e.g. 7d, 24h).
JWT_EXPIRES_IN=7d

# Admin account created by `npm run seed`. Change both before production.
ADMIN_EMAIL=admin@cynbit.in
ADMIN_PASSWORD=

# Port the API listens on.
PORT=4000

# The origin of your React frontend (CORS is restricted to this).
FRONTEND_URL=http://localhost:5173
