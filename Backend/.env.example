# Copy this file to .env and fill in real values. Never commit the .env file.

# JWT secret for admin authentication (sign-in / session cookies).
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Default admin account seeded on first start.
ADMIN_EMAIL=admin@cynbit.in
ADMIN_PASSWORD=replace-with-a-strong-password

PORT=4000
FRONTEND_URL=http://localhost:5173

# No MongoDB needed — JSON file storage is used by default.
